<style>
  .site-footer {
    background-color: var(--gray-500);
    color: white;
    padding: 120px 108px;
    display: flex;
    justify-content: space-between;
    gap: 100px;
  }

  .footer-brand {
    max-width: 600px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .logo-placeholder {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: white;
    color: var(--gray-500);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
  }

  .footer-logo span {
    font-family: var(--font-body);
    font-size: 42px;
    font-weight: 600;
  }

  .footer-brand > p {
    margin-top: 40px;
    font-size: 28px;
    line-height: 1.55;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, auto);
    column-gap: 100px;
    row-gap: 60px;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-column h3 {
    font-family: var(--font-body);
    font-size: 24px;
    margin-bottom: 4px;
  }

  .footer-column a,
  .footer-column p {
    color: white;
    font-family: var(--font-body);
    font-size: 24px;
    line-height: 1.5;
  }

  .footer-column a {
    text-decoration: underline;
  }

  .footer-column p {
    margin: 0;
  }
</style>
